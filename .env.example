# Groq (ฟรี): สร้าง key ที่ https://console.groq.com/keys
# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
AI_API_KEY=gsk_your_key_here
AI_MODEL=openai/gpt-oss-120b
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change_me
MAX_INPUT_CHARS=8000
VIOLATION_THRESHOLD=3
COOLDOWN_SECONDS=600

# --- ใช้เมื่อนำขึ้นโฮสต์ออนไลน์ ---
# APP_PASSWORD=ตั้งรหัสผ่านเข้าแอป (ว่าง = ไม่ต้องล็อกอิน)
# ENV=production
# TRUST_PROXY=1
# ENABLE_SCAN=0
